rules_version = '2';
// Ultra Deep Field: who can read and write what.
// Paste this into Firebase console → Firestore Database → Rules, then tap Publish.
// Replace OWNER_UID with your own User UID from Authentication → Users.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid in ['OWNER_UID']; }

    // each commander's saved empire: private to that commander.
    // The server keeps saves in order: every save carries the next number (seq), so a stale copy open on another device
    // can't save over newer progress. A save that would wipe out more than half of a built-up empire is refused unless
    // the game marks it as deliberate (starting over, restoring a backup, importing).
    match /data/users/{uid}/save {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && request.auth.uid == uid
        && (!('seq' in resource.data) || request.resource.data.get('seq', 0) == resource.data.seq + 1)
        && (!('lv' in resource.data) || resource.data.lv < 10 || request.resource.data.get('shrink', false) == true
            || request.resource.data.get('lv', 0) * 2 >= resource.data.lv);
    }
    match /data/users/{uid}/backups/{b} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // leaderboard rows and public names: everyone reads, only you write your own
    match /players/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && (request.auth.uid == uid || isOwner());
    }
    match /players/{uid}/av/{doc} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /profiles/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // tester feedback: anyone signed in can send, only the owner can read
    match /feedback/{id} {
      allow create: if signedIn();
      allow read, update, delete: if isOwner();
    }

    // direct messages: only the two people in the conversation can read them
    match /dms/{id} {
      allow read: if signedIn() && (resource == null || request.auth.uid in resource.data.p);
      allow write: if signedIn();
    }

    // the shared galaxy: worlds, fleets, alliances, chat and events
    match /{coll}/{id} {
      allow read, write: if signedIn() && coll in ['planets', 'occ', 'inbox', 'inbound', 'alliances', 'assaults', 'chat', 'event', 'galaxy', '_locks'];
    }
  }
}
